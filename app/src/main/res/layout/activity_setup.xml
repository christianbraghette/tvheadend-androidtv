<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/setup_title"
            android:textAppearance="@android:style/TextAppearance.Large" />

        <EditText
            android:id="@+id/host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/host"
            android:imeOptions="actionNext"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/port"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:text="9981" />

        <CheckBox
            android:id="@+id/https"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/https" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/protocol" />

        <RadioGroup
            android:id="@+id/protocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/protocol_http"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/protocol_http"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/protocol_http" />

            <RadioButton
                android:id="@+id/protocol_htsp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/protocol_htsp" />
        </RadioGroup>

        <EditText
            android:id="@+id/htsp_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/htsp_port"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:text="9982" />

        <EditText
            android:id="@+id/web_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/web_root"
            android:imeOptions="actionNext"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/username"
            android:imeOptions="actionNext"
            android:inputType="text" />

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/password"
            android:imeOptions="actionNext"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/profile"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:text="pass" />

        <Button
            android:id="@+id/connect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/connect" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
